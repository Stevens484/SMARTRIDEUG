rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function user() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function driver() { return get(/databases/$(database)/documents/drivers/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && user().role == 'admin'; }
    function isDriver() { return signedIn() && user().role == 'driver'; }
    function isAssignedDriver(busId) {
      return isDriver() &&
        driver().assignedBusId == busId;
    }
    function isAssignedTrip(busId) {
      return isAssignedDriver(busId) &&
        request.resource.data.busId == busId &&
        request.resource.data.driverId == request.auth.uid &&
        request.resource.data.routeId == driver().assignedRouteId &&
        get(/databases/$(database)/documents/buses/$(busId)).data.driverId == request.auth.uid &&
        get(/databases/$(database)/documents/buses/$(busId)).data.busNumber == request.resource.data.busNumber &&
        get(/databases/$(database)/documents/buses/$(busId)).data.totalSeats == request.resource.data.totalSeats &&
        get(/databases/$(database)/documents/buses/$(busId)).data.availableSeats == request.resource.data.availableSeats &&
        get(/databases/$(database)/documents/routes/$(driver().assignedRouteId)).data.name == request.resource.data.routeName &&
        get(/databases/$(database)/documents/routes/$(driver().assignedRouteId)).data.origin == request.resource.data.origin &&
        get(/databases/$(database)/documents/routes/$(driver().assignedRouteId)).data.destination == request.resource.data.destination;
    }
    function ownsBooking() {
      return signedIn() && resource.data.passengerId == request.auth.uid;
    }
    function passengerMayUpdateProfile() {
      return request.auth.uid == resource.id &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.employeeId == resource.data.employeeId &&
        (!request.resource.data.keys().hasAll(['name']) ||
          (request.resource.data.name is string &&
            request.resource.data.name.size() > 0 &&
            request.resource.data.name.size() <= 120)) &&
        (!request.resource.data.keys().hasAll(['displayName']) ||
          (request.resource.data.displayName is string &&
            request.resource.data.displayName.size() > 0 &&
            request.resource.data.displayName.size() <= 120)) &&
        (!request.resource.data.keys().hasAll(['phone']) ||
          (request.resource.data.phone is string &&
            request.resource.data.phone.size() <= 40)) &&
        (!request.resource.data.keys().hasAll(['photoUrl']) ||
          (request.resource.data.photoUrl is string &&
            request.resource.data.photoUrl.size() <= 2000)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'displayName', 'phone', 'photoUrl', 'updatedAt'
        ]);
    }
    function driverMayUpdateBooking() {
      return isAssignedDriver(resource.data.busId) &&
        request.resource.data.passengerId == resource.data.passengerId &&
        request.resource.data.busId == resource.data.busId &&
        request.resource.data.routeId == resource.data.routeId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'boarded', 'boardedAt'
        ]);
    }
    function passengerMayChangeBooking() {
      return ownsBooking() &&
        request.resource.data.passengerId == resource.data.passengerId &&
        request.resource.data.busId == resource.data.busId &&
        request.resource.data.routeId == resource.data.routeId &&
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'liveLatitude', 'liveLongitude', 'liveLocationActive',
            'liveLocationUpdatedAt', 'liveLocationStoppedAt'
          ]) ||
          (resource.data.status == 'held' &&
            request.resource.data.status in ['confirmed', 'cancelled'] &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'readyToBoard', 'confirmedAt', 'cancelledAt'
            ])) ||
          (resource.data.status in ['confirmed', 'boarded', 'completed'] &&
            request.resource.data.journeyRating is int &&
            request.resource.data.journeyRating >= 1 &&
            request.resource.data.journeyRating <= 5 &&
            request.resource.data.driverRating is int &&
            request.resource.data.driverRating >= 1 &&
            request.resource.data.driverRating <= 5 &&
            request.resource.data.busRating is int &&
            request.resource.data.busRating >= 1 &&
            request.resource.data.busRating <= 5 &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'journeyRating', 'driverRating', 'busRating', 'ratedAt'
            ]))
        );
    }
    function hasApprovedOperatorInvite() {
      return get(/databases/$(database)/documents/operatorIds/
        $(request.resource.data.role + '_' + request.resource.data.employeeId)).data.approved == true &&
        get(/databases/$(database)/documents/operatorIds/
          $(request.resource.data.role + '_' + request.resource.data.employeeId)).data.role == request.resource.data.role;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() ||
        (request.auth.uid == userId &&
          (request.resource.data.role == 'passenger' || hasApprovedOperatorInvite()));
      allow update: if isAdmin() ||
        passengerMayUpdateProfile();
      allow delete: if isAdmin();
    }

    // Staff provisioning records are confidential and managed by admins.
    match /operatorIds/{operatorId} {
      // Employee IDs must not be enumerable by ordinary accounts because they
      // are used as staff provisioning credentials.
      allow read, write: if isAdmin();
    }

    match /drivers/{driverId} {
      allow read: if signedIn() && (request.auth.uid == driverId || isAdmin());
      allow create: if isAdmin() ||
        (request.auth.uid == driverId && user().role == 'driver');
      allow update, delete: if isAdmin();
    }

    match /{collection}/{document} {
      allow read: if collection in ['buses', 'routes', 'stops', 'helpSupport'];
      allow write: if isAdmin() &&
        collection in ['buses', 'routes', 'stops', 'helpSupport', 'fares'];
    }

    // Stops are stored beneath their route as well as in the top-level stops
    // collection, so route maps can load an ordered route directly.
    match /routes/{routeId}/stops/{stopId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 120 &&
        request.resource.data.latitude is number &&
        request.resource.data.longitude is number &&
        request.resource.data.order is number &&
        request.resource.data.farePerKilometre is number &&
        request.resource.data.farePerKilometre > 0;
      allow delete: if isAdmin();
    }

    // Platform announcements, including promotions, are authored by admins
    // and shown to signed-in passengers in real time.
    match /notifications/{notificationId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.title.size() <= 120 &&
        request.resource.data.body is string &&
        request.resource.data.body.size() > 0 &&
        request.resource.data.body.size() <= 1000 &&
        request.resource.data.audience is string &&
        request.resource.data.audience in ['all', 'passengers', 'drivers'];
      allow delete: if isAdmin();
    }

    match /appSettings/{settingId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() &&
        settingId == 'support' &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 160 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 60 &&
        request.resource.data.faqs is list &&
        request.resource.data.faqs.size() <= 20;
      allow delete: if isAdmin();
    }

    match /busLocations/{busId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || isAssignedTrip(busId);
      allow delete: if isAdmin();
    }

    match /busStatus/{busId} {
      allow read: if signedIn();
      allow create, update: if isAdmin() || isAssignedTrip(busId);
      allow delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow read: if signedIn() &&
        (ownsBooking() || isAdmin() ||
          isAssignedDriver(resource.data.busId));
      allow create: if signedIn() &&
        request.resource.data.passengerId == request.auth.uid &&
        request.resource.data.busId is string &&
        request.resource.data.routeId is string &&
        request.resource.data.seats is list &&
        request.resource.data.seats.size() > 0 &&
        request.resource.data.seats.size() <= 8 &&
        request.resource.data.status == 'held';
      allow update: if isAdmin() || driverMayUpdateBooking() ||
        passengerMayChangeBooking();
      allow delete: if isAdmin();
    }

    match /seatHolds/{holdId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.passengerId == request.auth.uid &&
        request.resource.data.bookingId is string &&
        request.resource.data.busId is string &&
        request.resource.data.routeId is string &&
        request.resource.data.seat is string &&
        request.resource.data.status == 'held' &&
        getAfter(/databases/$(database)/documents/bookings/
          $(request.resource.data.bookingId)).data.passengerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/bookings/
          $(request.resource.data.bookingId)).data.busId == request.resource.data.busId &&
        getAfter(/databases/$(database)/documents/bookings/
          $(request.resource.data.bookingId)).data.seats.hasAny([request.resource.data.seat]);
      allow update: if signedIn() && resource.data.passengerId == request.auth.uid &&
        request.resource.data.passengerId == resource.data.passengerId &&
        request.resource.data.status == 'confirmed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'confirmedAt'
        ]);
      allow delete: if signedIn() && resource.data.passengerId == request.auth.uid;
    }

    match /reports/{reportId} {
      allow read, write: if isAdmin();
    }
  }
}
